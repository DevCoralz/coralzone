# Copy the ones you need into Vercel → Project → Settings → Environment
# Variables. Nothing here needs VITE_ prefixing — the API lives in this
# same app under /api, so the browser never needs to know a backend URL.

# --- Database (required) ---------------------------------------------------
# Accepts a plain mysql:// URL or the jdbc:mysql://... form your DB
# dashboard gave you — the "jdbc:" prefix is stripped automatically.
# Example from this project:
#   jdbc:mysql://user:pass@host:3306/dbname
DATABASE_URL=
# Set to "true" only if your MySQL host requires TLS.
DATABASE_SSL=false

# --- Session signing / hashing pepper (required) ---------------------------
# Any long random string — keys the HMAC used to hash OTP codes and
# session tokens before they're stored (api/_lib/security.js).
SESSION_SECRET=

# --- One-time schema setup, no terminal needed (required once) -------------
# Set this, deploy, then visit
#   https://<your-domain>/api/admin/migrate?secret=<this value>
# once in a browser to create the auth tables. Then delete or change this
# var so the URL can't be used again — see api/admin/migrate.js.
MIGRATION_SECRET=

# --- SMTP (required for signup/login email confirmation) -------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Google sign-in (optional — button degrades gracefully without it) -----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to https://<your-deployment-host>/api/auth/google-callback
GOOGLE_REDIRECT_URI=

# --- Storage service (optional — Cloud pages show demo/empty state until set) -
# The coralz-storage FastAPI service, reached server-to-server through your
# Cloudflare Tunnel. URL is the tunnel host ONLY — no /api/v1/storage suffix,
# src/lib/storage.functions.ts appends that itself.
#   STORAGE_SERVICE_URL=https://your-tunnel-host.example.com
STORAGE_SERVICE_URL=
# Must match STORAGE_SERVICE_KEY in the storage service's own .env exactly —
# sent as the X-Service-Key header on every call except the public download route.
STORAGE_SERVICE_KEY=

# --- Admin access (required for /admin) --------------------------------------
# The ONE verified account that can open /admin and call the admin API.
# Compared case-insensitively against the signed-in user's verified email,
# both in the app (SSR guard) and in the API gateway.
ADMIN_EMAIL=
