{
  "name": "coralzone-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "cd frontend && bun run dev",
    "dev:frontend": "cd frontend && bun run dev",
    "dev:backend": "cd backend && node --watch src/index.js",
    "build": "cd frontend && bun run build",
    "test": "cd frontend && bun run test",
    "lint": "cd frontend && bun run lint"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3"
  },
  "devDependencies": {
    "drizzle-kit": "0.x",
    "drizzle-orm": "0.x",
    "postgres": "^3.4.9"
  }
}
